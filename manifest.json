{
  "manifest_version": 3,
  "name": "LPU Auto Login",
  "version": "1.0",
  "permissions": ["scripting", "activeTab"],
  "host_permissions": ["https://internet.lpu.in/*"],

  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },

  "content_scripts": [
    {
      "matches": ["https://internet.lpu.in/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}